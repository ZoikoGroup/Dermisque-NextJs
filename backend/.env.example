# Shared with frontend/.env
JWT_SECRET="change-me-to-a-long-random-string"
CORS_ORIGINS="http://localhost:3000"
PUBLIC_URL="http://127.0.0.1:8000"
ADMIN_EMAIL="admin@dermisque.com"
ADMIN_PASSWORD="Admin@12345"
# PostgreSQL from docker-compose.yml (password = POSTGRES_PASSWORD in the root .env)
DATABASE_URL="postgresql+psycopg://dermisque:change-me@127.0.0.1:5440/dermisque"

# Fixed exchange rate for the GBP currency switch (1 USD = x GBP)
GBP_RATE=0.79

# Email (SMTP over SSL). MAIL_ENABLED=false logs emails without sending.
SMTP_HOST="smtpout.secureserver.net"
SMTP_PORT=465
SMTP_USERNAME="Info@dermisque.com"
SMTP_PASSWORD=""
MAIL_FROM="Info@dermisque.com"
MAIL_FROM_NAME="Dermisque"
ADMIN_NOTIFY_EMAIL="Info@dermisque.com"
MAIL_ENABLED=true
# Public storefront URL used for links in emails
SITE_URL="http://localhost:3100"
# Abandoned-cart reminders: hours after the cart was last changed (one email per entry)
CART_REMINDER_HOURS="1,24"

# Shop assistant: add an Anthropic API key to answer with Claude; leave empty for the built-in assistant
ANTHROPIC_API_KEY=""
CHAT_MODEL="claude-opus-5-5"
